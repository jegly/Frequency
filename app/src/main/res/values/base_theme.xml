<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        base_theme.xml — only the window/animation base wrappers.
        AppTheme.* variants live in themes.xml
        Component styles live in styles.xml
    -->

    <style name="ThemeLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:windowAnimationStyle">@style/WindowTransitions</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:textViewStyle">@style/ProductRegularTextViewStyle</item>
        <item name="android:buttonStyle">@style/ProductRegularButtonStyle</item>
    </style>

    <style name="ThemeDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="android:windowAnimationStyle">@style/WindowTransitions</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:textViewStyle">@style/ProductRegularTextViewStyle</item>
        <item name="android:buttonStyle">@style/ProductRegularButtonStyle</item>
    </style>

</resources>
