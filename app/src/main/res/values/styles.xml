<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =============================================
         TUNES — Material 3 Expressive Component Styles
         ============================================= -->

    <!-- Navigation Bar (M3 NavigationBar replaces BottomNavigationView) -->
    <style name="Widget.Tunes.NavigationBar" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Tunes.NavigationBar.ActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Tunes.NavActive</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Tunes.NavInactive</item>
        <item name="itemIconTint">@color/nav_icon_tint</item>
    </style>

    <style name="Widget.Tunes.NavigationBar.ActiveIndicator" parent="">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Tunes.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.Tunes.NavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Tunes.NavActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?colorOnSecondaryContainer</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.Tunes.NavInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Tunes.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?colorOnSurface</item>
        <item name="subtitleTextColor">?colorOnSurfaceVariant</item>
        <item name="titleTextAppearance">@style/TextAppearance.Tunes.TitleLarge</item>
    </style>

    <!-- Text appearances mapped to M3 type scale -->
    <style name="TextAppearance.Tunes.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>

    <style name="TextAppearance.Tunes.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Tunes.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Tunes.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Tunes.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Tunes.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>

    <style name="TextAppearance.Tunes.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Tunes.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>

    <style name="TextAppearance.Tunes.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
    </style>

    <!-- Cards — M3 Filled + Elevated + Outlined -->
    <style name="Widget.Tunes.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerHigh</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Tunes.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Mini player (MiniPlayer / ControlsFragment) — M3 Surface + shadow -->
    <style name="Widget.Tunes.MiniPlayer" parent="">
        <item name="android:background">?attr/colorSurfaceContainerHigh</item>
        <item name="android:elevation">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Chips (M3 FilterChip / AssistChip style for category headers) -->
    <style name="Widget.Tunes.Chip.Category" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">8dp</item>
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">?colorOutlineVariant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Tunes.LabelLarge</item>
        <item name="textStartPadding">12dp</item>
        <item name="textEndPadding">12dp</item>
    </style>

    <!-- FAB -->
    <style name="Widget.Tunes.ExtendedFAB" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.Tunes.FAB</item>
    </style>

    <style name="ShapeAppearance.Tunes.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Tunes.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Tunes.Button</item>
    </style>

    <style name="Widget.Tunes.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Tunes.Button</item>
    </style>

    <style name="ShapeAppearance.Tunes.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Icon buttons -->
    <style name="Widget.Tunes.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Widget.Tunes.IconButton.Small">
        <item name="android:padding">6dp</item>
    </style>

    <style name="Widget.Tunes.IconButton.XSmall">
        <item name="android:padding">12dp</item>
    </style>

    <!-- SeekBar — M3 Slider style -->
    <style name="Widget.Tunes.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">?colorPrimary</item>
        <item name="trackColorActive">?colorPrimary</item>
        <item name="trackColorInactive">?colorSurfaceVariant</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">10dp</item>
    </style>

    <!-- BottomSheet -->
    <style name="Widget.Tunes.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?colorSurfaceContainerLow</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Tunes.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Tunes.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Now Playing card shape -->
    <style name="ShapeAppearance.Tunes.AlbumArt" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Popup menu -->
    <style name="PopupMenu">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">@dimen/default_elevation</item>
    </style>

    <!-- Window transitions (unchanged) -->
    <style name="WindowTransitions" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- Legacy compat aliases used in layouts not yet migrated -->
    <style name="NavBarActiveTextAppearance">
        <item name="android:textColor">?colorOnSecondaryContainer</item>
    </style>
    <style name="NavBarInActiveTextAppearance">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
    </style>
    <style name="ToolbarPopupTheme">
        <item name="android:popupBackground">?colorSurface</item>
    </style>
    <style name="ToolbarTitleTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <style name="Headline20TextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSurface</item>
    </style>
    <style name="ItemTitleTextAppearance">
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <style name="ItemSubTextAppearance">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <style name="RecyclerViewItemTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
    </style>
    <style name="RecyclerViewItemTitle.Sub">
        <item name="android:textAppearance">@style/ItemSubTextAppearance</item>
    </style>
    <style name="HomeItemTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">124dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
    </style>
    <style name="HomeItemTitle.Sub">
        <item name="android:textAppearance">@style/ItemSubTextAppearance</item>
    </style>
    <!-- HomeCategoryHeading now uses M3 AssistChip look -->
    <style name="HomeCategoryHeading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textColor">?colorOnSecondaryContainer</item>
        <item name="android:background">@drawable/chip_category_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="SettingsStyleBlock">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/settings_block_bg</item>
    </style>
    <style name="SettingItemHeadline18">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
    </style>
    <style name="SettingItemTextStyle" parent="SettingsStyleBlock">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="SettingItemSwitchStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="RadioBtnText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
    </style>
    <style name="ButtonStyleBase">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ButtonStyle48" parent="ButtonStyleBase" />
    <style name="ButtonStyle36" parent="ButtonStyleBase">
        <item name="android:padding">6dp</item>
    </style>
    <style name="ButtonStyle24" parent="ButtonStyleBase">
        <item name="android:padding">12dp</item>
    </style>
    <style name="MenuItemTextStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="LibraryItemMenuTextStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textAppearance">@style/ItemTitleTextAppearance</item>
        <item name="android:padding">18dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">?selectableItemBackground</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="BottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Tunes.BottomSheet</item>
    </style>
    <style name="AppInfoTitleTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="AppInfoSubTitleTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="MaterialButtonStyle.Default" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <style name="MaterialButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <!-- TextView / Button defaults -->
    <style name="ProductRegularTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>
    <style name="ProductRegularButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/dotgothic16_regular</item>
    </style>

</resources>
